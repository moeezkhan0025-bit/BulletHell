%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c59c69a7ef5ea0459b1e7b4d640de86, type: 3}
  m_Name: ArtProvenanceRules
  m_EditorClassIdentifier: BulletHell::BulletHell.Capture.ArtProvenanceRules
  artSourceMasterMeansFinal: 1
  artSourceFolder: ArtSource
  artFolder: Assets/Art
  checklistPath: Docs/ART_CHECKLIST.md
  creditsPath: Docs/CREDITS.md
  defaultStatus: 0
  rules:
  - name: Player art
    pathPrefix: Assets/Art/Player/
    nameGlob: 
    verdict: 0
    checklistText: 
    checklistFallback: 0
    reason: 'The developer''s own player art (CLAUDE.md: never replaced)'
  - name: Arm art
    pathPrefix: Assets/Art/Arms/
    nameGlob: 
    verdict: 0
    checklistText: 
    checklistFallback: 0
    reason: 'The developer''s own arm art (CLAUDE.md: never replaced)'
  - name: Placeholder folder
    pathPrefix: Assets/Art/Placeholder/
    nameGlob: 
    verdict: 1
    checklistText: 
    checklistFallback: 0
    reason: Lives in Assets/Art/Placeholder (stand-in shapes, M7.5 art, generated
      VoxVfx textures)
  - name: Menu backdrop
    pathPrefix: Assets/Art/UI/Backdrop/
    nameGlob: 
    verdict: 2
    checklistText: Menu background
    checklistFallback: 0
    reason: Generated by BulletHell/Vox/5; ART_CHECKLIST marks the menu background
      as a placeholder
  - name: Armament icons
    pathPrefix: Assets/Art/UI/VoxKit/
    nameGlob: icon_armament_*
    verdict: 2
    checklistText: Armament icons x5
    checklistFallback: 1
    reason: VoxKit icon; the checklist entry decides
  - name: Crate icon
    pathPrefix: Assets/Art/UI/VoxKit/
    nameGlob: icon_harvest_crate*
    verdict: 2
    checklistText: Card back
    checklistFallback: 1
    reason: VoxKit icon; the checklist entry (card back / crate) decides
  - name: VoxKit
    pathPrefix: Assets/Art/UI/VoxKit/
    nameGlob: 
    verdict: 0
    checklistText: 
    checklistFallback: 0
    reason: VoxKit is the project's single UI theme (CLAUDE.md); ART_CHECKLIST UI2
      marks the kit as done
  - name: Scale test without master
    pathPrefix: Assets/Art/ScaleTest/
    nameGlob: 
    verdict: 1
    checklistText: 
    checklistFallback: 0
    reason: Scale-test art with no ArtSource master
  - name: Audio
    pathPrefix: Assets/Audio/
    nameGlob: 
    verdict: 1
    checklistText: 
    checklistFallback: 0
    reason: 'CC0 pack sound (Docs/CREDITS.md: all audio is a CC0 placeholder)'
  sectionRules:
  - section: 6
    ownerPathContains: 
    ownerTypeContains: 
    propertyContains: icon
  - section: 2
    ownerPathContains: Assets/Data/Bosses/|Enemy_Pumpking|Enemy_BossPlaceholder|Boss.prefab
    ownerTypeContains: 
    propertyContains: 
  - section: 2
    ownerPathContains: 
    ownerTypeContains: BossData
    propertyContains: 
  - section: 3
    ownerPathContains: Assets/Data/Enemies/Patterns|Assets/Data/Ammo/|Projectile.prefab|EnemyBulletPalette
    ownerTypeContains: 
    propertyContains: 
  - section: 3
    ownerPathContains: 
    ownerTypeContains: AttackPattern|AmmoTypeData
    propertyContains: 
  - section: 1
    ownerPathContains: Assets/Data/Enemies/|Enemy.prefab
    ownerTypeContains: 
    propertyContains: 
  - section: 0
    ownerPathContains: Assets/Data/Player/|Assets/Data/Arms/|Assets/Data/Cosmetics/|Assets/Data/Loadouts/|Assets/Data/AssetRegistry|Player.prefab|Arm.prefab|GladiatorDoll.prefab
    ownerTypeContains: 
    propertyContains: 
  - section: 5
    ownerPathContains: Assets/Prefabs/Vfx/|Assets/Data/Feedback/|Assets/Art/Materials/
    ownerTypeContains: 
    propertyContains: 
  - section: 4
    ownerPathContains: Assets/Data/Arenas/|Assets/Data/Settings/ArenaArt|Obstacle.prefab|Trap.prefab|Coin.prefab|AmmoPickup.prefab|Assets/Data/Pickups/
    ownerTypeContains: 
    propertyContains: 
  - section: 6
    ownerPathContains: Assets/Data/UI/|Assets/Prefabs/UI/|Assets/Data/Armaments/|Assets/Data/Shop/
    ownerTypeContains: 
    propertyContains: 
  specRules:
  - matchSection: 0
    section: 8
    contains: Playersprite
    needs: 'Player body is the developer''s final art. Keep the 302x315 canvas at
      PPU 273.9, pivot centre. Full spec: idle, run (4), jump takeoff and land, facings
      down / side / up.'
  - matchSection: 1
    section: 0
    contains: Art/Arms/|arm_
    needs: Arm drawn pointing right, 256x256 at PPU 347.8, pivot on the attach point
      (shoulder). Dark outline, light from top-left.
  - matchSection: 1
    section: 0
    contains: part_|Cosmetics
    needs: Paper-doll part on the same canvas as Playersprite (302x315, PPU 273.9,
      pivot centre), identical neck / shoulder joins, uncompressed. Layer order body
      < armor < head < accessory.
  - matchSection: 1
    section: 0
    contains: 
    needs: Character canvas 768x768 (2x export of the 1536 master), PPU 191.3 (1.15x
      lock), feet on the pivot, 4 px padding.
  - matchSection: 1
    section: 2
    contains: 
    needs: 'Boss canvas 1280x1280 (2560 master), PPU 191.3, Single sprite, bilinear,
      CompressedHQ, pivot at the base of the art. Key poses: idle, windup, attack.
      Pumpking is about 2.7 P tall.'
  - matchSection: 1
    section: 1
    contains: 
    needs: Character canvas 768x768 (1536 master), PPU 191.3, Single sprite, bilinear,
      CompressedHQ, pivot at the feet, side facing (flipped in code), key poses idle
      / windup / attack.
  - matchSection: 1
    section: 3
    contains: 
    needs: 'Bullet canvas 192x192 (384 master). Player bullets WHITE / light grey
      (tinted by the arm). Enemy bullets: bright core + dark outline, reserved Electric
      Violet #B44BFF, boss Hot Magenta #FF3DCB, never floor red. 0.15-0.3 P.'
  - matchSection: 1
    section: 4
    contains: backdrop|ArenaArt
    needs: 'Arena 3840x2160 (7680x4320 master), PPU 220, LAYERED: floor + decals,
      back wall / crowd, side walls, foreground railing and front crowd over gameplay.
      Never one flattened image.'
  - matchSection: 1
    section: 4
    contains: LowWall|Crate|Cabbage
    needs: 'Low obstacle (<= 0.5 P): 256x128 (512x256 master), pivot at the footprint
      centre, ''jumpable'' cap colour, separate _shadow sprite. Breakable: intact
      / dmg1 / dmg2 / flat debris.'
  - matchSection: 1
    section: 4
    contains: Pillar|Pumpkin
    needs: 'Tall obstacle (>= 1.5 P): 256x384 (512x768 master), pivot at the footprint
      centre, separate _shadow sprite. Breakable: dmg1 / dmg2 / debris + chunks.'
  - matchSection: 1
    section: 4
    contains: Trap
    needs: 'Floor trap canvas 768x576 (1536x1152 master), flat (x0.6). States: idle,
      telegraph (2-4 frames, DANGER #FF4D33), active (3-4), cooldown (2-3).'
  - matchSection: 1
    section: 4
    contains: Coin|Pickup
    needs: Pickup 0.3-0.4 P, 128 canvas, coin spin 6 frames, flat floor glow ellipse
      (x0.6) underneath.
  - matchSection: 1
    section: 4
    contains: 
    needs: 'Arena prop: pivot at the footprint centre, flat things squashed by F
      = 0.6, light from top-left, dark outline.'
  - matchSection: 1
    section: 5
    contains: 
    needs: Small white texture, tinted in code (soft dot, spark streak, smoke puff,
      shard); floor effects flat (x0.6); telegraph glow tinted DANGER #FF4D33. PPU
      = pixel width.
  - matchSection: 1
    section: 6
    contains: icon
    needs: 'Icon, rarity rim drawn white (tinted in code). VoxKit import: Single
      sprite, PPU 200, uncompressed, 2x art (ART_SPEC icon canvas 384).'
  - matchSection: 1
    section: 6
    contains: Backdrop
    needs: Key art or wide arena shot for the menus, 16:9, blurred or darkened behind
      the panels.
  - matchSection: 1
    section: 6
    contains: VoxKit
    needs: 'VoxKit sprite: 2x art, PPU 200, uncompressed, 9-slice borders and tokens
      from vox_ui_kit_manifest.json (BulletHell/Vox/1 Import Kit Sprites).'
  - matchSection: 1
    section: 6
    contains: 
    needs: 'Themed UI sprite: VoxKit look (marble, soil-brown outline, corn-gold
      focus), PPU 200, 9-slice friendly even borders.'
  - matchSection: 1
    section: 7
    contains: Music
    needs: 'Music: stereo Vorbis (quality 0.5), Load Type Streaming, seamless loop
      points.'
  - matchSection: 1
    section: 7
    contains: 
    needs: 'SFX: mono Vorbis (quality 0.6), Decompress On Load, short (rapid-fire
      cues under 0.3 s). Reassign the clip on its SfxData / AudioLibrary asset.'
  - matchSection: 0
    section: 8
    contains: 
    needs: Painted HD PNG RGBA, bilinear, pivot at the base, 4 px padding, dark outline,
      light from top-left (ART_SPEC section 1).
